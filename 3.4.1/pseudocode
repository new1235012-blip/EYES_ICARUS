class SegmentedHeatbed:
    def __init__(self, width, height, rows, cols, safe_margin=10):
        # Khởi tạo thông số bàn in
        self.grid = self._create_grid(width, height, rows, cols)
        self.safe_margin = safe_margin

    def process_gcode(self, gcode_path):
        # BƯỚC 1: PARSING
        layers_data = self._parse_layers(gcode_path)
        
        # BƯỚC 2 & 3: MAPPING & LOGIC (Cộng dồn)
        heating_schedule = []
        accumulated_pads = set() # Tập hợp các pad đã bật
        
        for layer in layers_data:
            # Lấy vùng bao của lớp hiện tại
            bbox = layer['bbox']
            
            # Tìm các pad nằm dưới vùng bao này (có tính safe_margin)
            current_layer_pads = self._map_bbox_to_pads(bbox, self.safe_margin)
            
            # LOGIC CỐT LÕI: Cộng dồn (Union)
            # Miếng nhiệt nào đã bật thì giữ nguyên, chỉ thêm mới
            accumulated_pads.update(current_layer_pads)
            
            # Lưu trạng thái: Tại độ cao Z này, cần bật những pad này
            heating_schedule.append({
                'z_height': layer['z'],
                'active_pads': list(accumulated_pads) # Convert set to list
            })
            
        return heating_schedule

